Implement Map-reduce and aggregation, indexing with suitable example in MongoDB.
Demonstrate the following:
● Aggregation framework
● Create and drop different types of indexes and explain () to show the advantage of the indexes




use collegeDB

db.sales.insertMany([
  {item:"Laptop", quantity:2, price:50000},
  {item:"Mobile", quantity:5, price:20000},
  {item:"Laptop", quantity:3, price:50000},
  {item:"Tablet", quantity:4, price:15000}
])


db.sales.aggregate([
 {
   $group:{
      _id:"$item",
      totalQuantity:{$sum:"$quantity"}
   }
 }
])


var map = function() {
    emit(this.item, this.quantity);
};

var reduce = function(key, values) {
    return Array.sum(values);
};


db.sales.mapReduce(
   map,
   reduce,
   { out: "sales_result" }
);


db.sales_result.find();

db.sales.createIndex({item:1})

db.sales.createIndex({item:1, quantity:-1})

db.sales.createIndex({item:"text"})

db.sales.getIndexes()

db.sales.find({item:"Laptop"}).explain("executionStats")



db.sales.createIndex({item:1})

db.sales.find({item:"Laptop"}).explain("executionStats")


db.sales.dropIndex({item:1})
db.sales.dropIndexes()
