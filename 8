Create a JQuery application which will do login authentication.





<!DOCTYPE html>
<html>
<head>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>

<input id="u" placeholder="Username">
<input id="p" type="password" placeholder="Password">
<button id="b">Login</button>

<script>
$("#b").click(() =>
  alert($("#u").val()=="admin" && $("#p").val()=="1234"
    ? "Login Successful"
    : "Invalid Login")
);
</script>

</body>
</html>
